# Copy to a private env file. Never commit the real values.
# SQLite is embedded in the server. Always use a LOCAL disk, never a network share.
RUFA_DATABASE_PATH=/var/lib/rufa-dsh/company.sqlite
RUFA_SECRET_FILE=/var/lib/rufa-dsh/secrets/deepseek.json
HOST=127.0.0.1
PORT=8787
RUFA_UPSTREAM_BASE_URL=https://api.deepseek.com
RUFA_UPSTREAM_API_KEY=
RUFA_ALLOWED_MODELS=deepseek-flash
RUFA_MAX_CONCURRENT=2
RUFA_MAX_USER_CONCURRENT=1
RUFA_MAX_CONCURRENT_UPLOADS=1
RUFA_MAX_OUTPUT_TOKENS=384000
# Public Windows installer feed, deployed atomically by the coordinator.
# Omit to use client-releases beside the SQLite database. Never use a user upload directory.
RUFA_CLIENT_RELEASES_DIR=/var/lib/rufa-dsh/client-releases
# Only needed for the optional PostgreSQL/Docker draft:
# POSTGRES_PASSWORD=
# RUFA_LOCAL_PORT=8787
# Initial admin is created once with the CLI. No default password exists.
RUFA_BOOTSTRAP_USERNAME=
RUFA_BOOTSTRAP_DISPLAY_NAME=
RUFA_BOOTSTRAP_PASSWORD=
