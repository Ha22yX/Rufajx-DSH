{
  "name": "@rufa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "migrate": "tsx src/cli.ts migrate",
    "bootstrap-admin": "tsx src/cli.ts bootstrap-admin",
    "backup": "tsx src/cli.ts backup"
  },
  "dependencies": { "fastify": "^5.6.0", "pg": "^8.16.3" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/pg": "^8.15.5", "tsx": "^4.20.0", "typescript": "^5.9.3" }
}
