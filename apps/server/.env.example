# Server-only environment. Never package this file with the employee client.
RUFA_DATABASE_DRIVER=sqlite
# Use an absolute path on the server's local disk, not a network share.
RUFA_DATABASE_PATH=./data/rufa-dsh.sqlite
HOST=127.0.0.1
PORT=8787
RUFA_UPSTREAM_BASE_URL=https://api.deepseek.com
RUFA_UPSTREAM_API_KEY=
# Optional initial fallback above; admin-saved file takes precedence on restart.
RUFA_SECRET_FILE=./data/secrets/deepseek.json
RUFA_ALLOWED_MODELS=deepseek-flash
RUFA_ACCESS_TTL_SECONDS=900
RUFA_REFRESH_TTL_DAYS=14
RUFA_LEASE_TTL_SECONDS=120
RUFA_BODY_LIMIT_BYTES=33554432
RUFA_FILE_UPLOAD_LIMIT_BYTES=135266304
RUFA_MAX_CONCURRENT=12
RUFA_MAX_USER_CONCURRENT=4
RUFA_MAX_CONCURRENT_UPLOADS=1
RUFA_UPSTREAM_TIMEOUT_SECONDS=600
RUFA_MAX_OUTPUT_TOKENS=384000
# Supply only for initial bootstrap, then remove the password from the environment.
RUFA_BOOTSTRAP_USERNAME=
RUFA_BOOTSTRAP_DISPLAY_NAME=
RUFA_BOOTSTRAP_PASSWORD=
# Optional future PostgreSQL deployment only:
# RUFA_DATABASE_DRIVER=postgres
# DATABASE_URL=
